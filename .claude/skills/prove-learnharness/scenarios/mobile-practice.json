{
  "rules": [
    {
      "id": "pose-the-first-problem",
      "match": { "lastRole": "user", "lastIncludes": "mobile practice", "hasTool": "problem" },
      "reply": { "toolCalls": [{ "name": "problem", "arguments": {
        "mode": "recall",
        "statement": "**Find the positive solution** to $x^2=4$. Show one step.",
        "modelSolution": "Taking the positive square root gives $x=2$. The square of $2$ is $4$."
      } }] }
    },
    {
      "id": "hint-without-concluding",
      "match": { "lastRole": "user", "lastIncludes": "I am stuck", "hasTool": "conclude" },
      "reply": { "text": "Which operation undoes squaring on positive numbers?", "pauseBeforeDoneMs": 4000 }
    },
    {
      "id": "conclude-after-second-submission",
      "match": { "lastRole": "user", "lastIncludes": "The positive solution is 2", "hasTool": "conclude" },
      "reply": { "toolCalls": [{ "name": "conclude", "arguments": {
        "outcome": "solvedWithHints", "verdict": "You used the positive square root.", "rung": "R1",
        "missClass": null, "retest": false
      } }] }
    },
    {
      "id": "pose-after-explicit-next",
      "match": { "lastRole": "user", "lastIncludes": "[NEXT PROBLEM]", "hasTool": "problem" },
      "reply": { "toolCalls": [{ "name": "problem", "arguments": {
        "mode": "recall",
        "statement": "Evaluate $\\sqrt{9}$.",
        "modelSolution": "The positive square root of $9$ is $3$."
      } }] }
    }
  ],
  "fallback": { "text": "Fixture ready for the next learner input." }
}
