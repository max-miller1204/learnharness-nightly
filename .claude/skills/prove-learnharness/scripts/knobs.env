# prove-learnharness speed and environment knobs. Sourced by every script.
# Change these freely to tune speed; they never change what right looks like
# (that lives in budgets.json and the answer keys, which only the user edits).
# A real environment variable of the same name wins over the value here.

# Where base-commit builds and the pinned axe-core live, shared by every run
# and every worktree on this machine. Not /tmp: it is a small tmpfs here.
: "${PROVE_CACHE:=$HOME/.cache/prove-learnharness}"

# The branch the change is diffed against and whose merge-base is the base build.
: "${PROVE_BASE_REF:=origin/main}"

# How many production builds (head, base) may run at once. One build peaks at
# about 3.6 GB; this machine has 14 GB and other agents may be building too.
: "${MAX_PARALLEL_BUILDS:=2}"

# Base builds kept in the cache (newest first by use). Older ones are deleted.
: "${BASE_CACHE_KEEP:=4}"

# Skip a head rebuild when the working tree (tracked + untracked, minus
# ignored files) hashes the same as the last build. 0 always rebuilds.
: "${REUSE_HEAD_BUILD:=1}"

# Seed the base build's .next/cache from the head build before building it.
: "${SEED_BASE_NEXT_CACHE:=1}"

# Timeouts, in seconds.
: "${BOOT_TIMEOUT_S:=90}"
: "${TURN_TIMEOUT_S:=60}"
: "${SELFHOST_SWITCH_TIMEOUT_S:=240}"

# CLS budget mode (the user's choice, 2026-11-17): "relative" = head may not
# exceed base on the same page (+ the noise in budgets.json); "absolute" = head
# must be under budgets.json's absoluteMax. Absolute since the sidebar's
# opening shift on first load was fixed (docs/specs/polish-first-load.md).
# compare.mjs reads this default too.
: "${CLS_MODE:=absolute}"

# Model for the instance: "fake" (default: scripted, free, deterministic) or
# "claude-code" (opt-in real model through your installed, signed-in claude
# CLI, for model-behaviour checks only; costs subscription usage). With
# claude-code the server keeps your real HOME so the CLI finds its login.
: "${PROVE_MODEL:=fake}"
: "${PROVE_REAL_MODEL_ID:=haiku}"

# Browser and display.
: "${PROVE_CHROME:=/usr/bin/google-chrome}"
: "${AXE_CORE_VERSION:=4.10.3}"

# Electron. The downloaded chrome-sandbox is not SUID root on this machine,
# so Electron runs with --no-sandbox (a stand-in difference: receipts say so).
: "${ELECTRON_NO_SANDBOX:=1}"

# Version strings baked into prove builds (LH_VERSION), so the same build can
# be installed by the launcher. Base is always older than head.
: "${PROVE_BASE_VERSION_SUFFIX:=-nightly.20000101.1}"
: "${PROVE_HEAD_VERSION_SUFFIX:=-nightly.20000101.2}"
: "${PROVE_BROKEN_VERSION_SUFFIX:=-nightly.20000101.3}"

export PROVE_CACHE PROVE_BASE_REF MAX_PARALLEL_BUILDS BASE_CACHE_KEEP REUSE_HEAD_BUILD SEED_BASE_NEXT_CACHE \
	BOOT_TIMEOUT_S TURN_TIMEOUT_S SELFHOST_SWITCH_TIMEOUT_S CLS_MODE PROVE_MODEL PROVE_REAL_MODEL_ID PROVE_CHROME AXE_CORE_VERSION ELECTRON_NO_SANDBOX \
	PROVE_BASE_VERSION_SUFFIX PROVE_HEAD_VERSION_SUFFIX PROVE_BROKEN_VERSION_SUFFIX
