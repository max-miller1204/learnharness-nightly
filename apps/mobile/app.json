{
  "expo": {
    "name": "LearnHarness Nightly",
    "slug": "learnharness-nightly",
    "version": "0.1.0",
    "icon": "../../build/icon.png",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android"],
    "experiments": { "tsconfigPaths": false },
    "updates": { "enabled": false },
    "ios": {
      "bundleIdentifier": "com.maxmiller.learnharness.nightly",
      "supportsTablet": true,
      "infoPlist": { "ITSAppUsesNonExemptEncryption": false }
    },
    "android": {
      "package": "com.maxmiller.learnharness.nightly",
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "plugins": [
      ["expo-camera", {
        "cameraPermission": "Allow LearnHarness Nightly to use the camera to scan pairing QR codes and take photos you send.",
        "microphonePermission": false,
        "recordAudioAndroid": false
      }],
      ["expo-image-picker", {
        "cameraPermission": "Allow LearnHarness Nightly to use the camera to scan pairing QR codes and take photos you send.",
        "photosPermission": "Allow LearnHarness Nightly to access your photos so you can send them to your sessions.",
        "microphonePermission": false
      }],
      "expo-secure-store",
      ["expo-splash-screen", { "backgroundColor": "#faf9f5", "dark": { "backgroundColor": "#141414" } }],
      ["./plugins/android-menu-theme.js", {
        "light": { "surface": "#f0eee6", "border": "#e0ddd2", "text": "#3d3d3a" },
        "dark": { "surface": "#1c1c1c", "border": "#434343", "text": "#e6e6e6" }
      }]
    ],
    "extra": { "eas": { "projectId": "5e837ebd-6337-4a8b-9cfa-3d181424fe40" } },
    "owner": "max-miller1204s-team"
  }
}
