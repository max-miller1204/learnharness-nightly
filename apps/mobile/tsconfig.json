{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node", "react"],
    "paths": {
      "@earendil-works/*": ["./node_modules/@earendil-works/*"],
      "typebox": ["./node_modules/typebox"],
      "typebox/*": ["./node_modules/typebox/build/*/index.d.mts"]
    }
  },
  "include": ["index.ts", "src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts"]
}
